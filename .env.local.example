# 이 파일을 .env.local 로 복사한 뒤 가진 키만 채우십시오.
#   cp .env.local.example .env.local
#
# 전부 비워도 됩니다. 키가 하나도 없어도 BM25 검색, 권한 필터 전수 검사,
# 검색 평가는 전부 그대로 동작합니다.
#
# .env.local 은 .gitignore 에 있습니다. 커밋되지 않습니다.
# 실제 셸 환경변수가 이 파일보다 우선합니다.

# ---------- 임베딩 (dense / ensemble 검색에 필요) ----------
# 둘 중 하나만 있으면 됩니다. 아무것도 없으면 BM25 전용으로 동작합니다.
# Anthropic 에는 임베딩 API 가 없으므로 여기에 쓸 수 없습니다.
UPSTAGE_API_KEY=
OPENAI_API_KEY=

# ---------- 생성 (답변 작성에 필요) ----------
# 없으면 검색 결과만 표시됩니다. 검색·권한·거부 판정은 그대로 동작합니다.
ANTHROPIC_API_KEY=

# ---------- 온프렘 모드 (권장, 외부 API 호출 없음) ----------
# Ollama 를 띄우면 생성도 로컬에서 돕니다. 키가 필요 없습니다.
#   https://ollama.com 설치 후:  ollama pull qwen2.5:7b
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b

# ---------- 강제 지정 (평가에서 백엔드를 고정할 때만) ----------
# 비워두면 providers.py 가 자동으로 고릅니다. 온프렘(로컬)이 항상 1순위입니다.
# EMBED_BACKEND=bge        # bge | upstage | openai | hash
# GEN_BACKEND=ollama       # ollama | anthropic | upstage | openai
# DISABLE_LOCAL_MODEL=1    # 로컬 모델을 무시하고 API 백엔드를 쓰게 한다
